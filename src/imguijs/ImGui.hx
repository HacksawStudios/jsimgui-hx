	/**
		Draw outer borders.
	**/
	public static inline final BordersOuter:ImGuiTableFlags = BordersOuterV | BordersOuterH;

	/**
		Draw all borders.
	**/
	public static inline final Borders:ImGuiTableFlags = BordersInner | BordersOuter;

